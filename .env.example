# Database Infos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=database
POSTGRES_PORT=5432
# INFO: Caso esteja utilizando pelo docker, substituir o host pelo nome do serviço do banco (nesse caso 'db')
POSTGRES_HOST=localhost
# POSTGRES_HOST=db


# Redis Infos
REDIS_PORT=6379
# INFO: Caso esteja utilizando pelo docker, substituir o host pelo nome do serviço do redis (nesse caso 'redis')
REDIS_HOST=localhost
# REDIS_HOST=redis
# REDIS_URL="redis://<username>@<host>:<port>" ou redis://<username>:<password>@<host>:<port>"
REDIS_URL="redis://default@localhost:6379"


# API Infos
API_PORT=3000
TOKEN_EXPIRATION="1d"
SECRET_KEY=secret_key

